# Current target: patched llama-server with the released NEG head.
DARWIN_PRIMARY_BACKEND=native
DARWIN_PRIMARY_MODEL=darwin-9b-neg-native
DARWIN_NATIVE_URL=http://127.0.0.1:11436/v1
DARWIN_NATIVE_MODEL=darwin-9b-neg-native

# Research/reference mode for the released entropy head (not 12 GB friendly):
# DARWIN_PRIMARY_BACKEND=transformers
DARWIN_HF_MODEL=FINAL-Bench/Darwin-9B-NEG
DARWIN_LOAD_IN_4BIT=true

# Reuse the same resident Darwin model as verifier.
DARWIN_VERIFIER_BACKEND=native
DARWIN_VERIFIER_MODEL=darwin-9b-neg-native
OLLAMA_URL=http://127.0.0.1:11434

DARWIN_HOST=127.0.0.1
DARWIN_PORT=11435
DARWIN_MAX_CONTEXT=163840
DARWIN_MAX_TOKENS=43008
DARWIN_REVIEW_MAX_TOKENS=3072
DARWIN_GPQA_SOLVER_TOKENS=6144
DARWIN_GPQA_REVIEW_TOKENS=6144
DARWIN_TRUNCATION_RECOVERY_TOKENS=2048
DARWIN_CANDIDATES=3
DARWIN_MAX_ENSEMBLE_INFERENCES=20
DARWIN_CANDIDATE_TEMPERATURE=0.45
DARWIN_COMPLEXITY_THRESHOLD=3
DARWIN_NEG_ACTIVATION_THRESHOLD=0.05
DARWIN_NEG_MIN_ACTIVATIONS=16
DARWIN_ROUTE_TOOL_CALLS=true
DARWIN_TOOL_PHASE_MAX_TOKENS=4096
DARWIN_MAX_PARALLEL_TOOL_CALLS=32
DARWIN_UNCHANGED_TOOL_RESULT_LIMIT=2
